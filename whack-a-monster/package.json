{
    "name": "whack-a-monster",
    "description": "Whack-a-Monster — a portrait touch arcade game for MPArcade.",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --config vite/config.dev.mjs",
        "build": "tsc --noEmit && vite build --config vite/config.prod.mjs",
        "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
        "preview": "vite preview --config vite/config.prod.mjs"
    },
    "dependencies": {
        "phaser": "^3.90.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.0",
        "terser": "^5.39.0",
        "typescript": "^5.8.0",
        "vite": "^6.3.5"
    }
}
