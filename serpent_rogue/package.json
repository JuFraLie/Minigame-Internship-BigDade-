{
  "name": "serpent-rogue",
  "description": "Serpent Rogue — a roguelike snake game for MPArcade.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "tsc --noEmit && vite build --mode standalone",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.0.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
